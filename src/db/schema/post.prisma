model Post {
  id         String    @id @default(cuid())
  title      String
  content    String
  id_user    String
  created_at DateTime  @default(now())
  height     Int
  version    String
  width      Int
  url_bucket String
  comments   Comment[]
  user       User      @relation(fields: [id_user], references: [id])
  ratings    Ratings[]

  @@map("posts")
}
