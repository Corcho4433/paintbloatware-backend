model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  password      String?
  urlPfp        String?
  description   String?
  created_at    DateTime        @default(now())
  comments      Comment[]
  posts         Post[]
  ratings       Ratings[]
  sessions      Session[]
  CommentThread CommentThread[]
  accounts      Account[]
  Admin         Admin[]
  subscription  Subscription?
  payments      Payment[]
  
  @@map("users")
}