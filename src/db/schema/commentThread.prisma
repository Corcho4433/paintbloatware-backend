model CommentThread {
  id         String @id @default(cuid())
  content    String @db.Text
  id_user    String
  id_comment String

  user    User    @relation(fields: [id_user], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [id_comment], references: [id], onDelete: Cascade)

  @@map("comment_threads")
}
