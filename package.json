{
	"name": "paintbloatware-backend",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"prisma": {
		"schema": "src/db/schema"
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts ",
		"resetdb": "bun run src/utils/db.ts resetDatabase",
		"migrate": "prisma migrate dev --schema src/db/schema",
		"generate": "prisma generate --no-engine --schema src/db/schema",
		"seed": "bun run src/db/seed.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/bun": "latest",
		"@types/node": "^22.13.14",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.16",
		"@types/passport-jwt": "^4.0.1",
		"tsx": "^4.19.3"
	},
	"peerDependencies": {
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"@prisma/client": "^6.8.2",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.1",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^2.0.0",
		"@types/passport-github2": "^1.2.9",
		"@types/pg": "^8.11.11",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"minio": "^8.0.5",
		"multer": "^2.0.2",
		"passport": "^0.7.0",
		"passport-github2": "^0.1.12",
		"passport-google-oauth20": "^2.0.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.14.1",
		"postgres": "^3.4.5",
		"prisma": "^6.7.0"
	}
}
